# Εξαίρεση φακέλου εξαρτήσεων node_modules
# Exclude node_modules dependency folder
node_modules/

# Εξαίρεση φακέλου build παραγωγής
# Exclude production build output folder
dist/
dist-ssr/

# Εξαίρεση τοπικών μεταβλητών περιβάλλοντος
# Exclude local environment variables files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Εξαίρεση αρχείων καταγραφής σφαλμάτων
# Exclude log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Εξαίρεση ρυθμίσεων IDE & Editor
# Exclude IDE and Editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?